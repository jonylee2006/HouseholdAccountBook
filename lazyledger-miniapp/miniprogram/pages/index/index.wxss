.summary-title {
  color: #999;
}
.summary-value {
  font-size: 56rpx;
  font-weight: bold;
  margin-top: 16rpx;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.remain {
  color: #27ae60;
}
.section-title {
  font-weight: bold;
  margin-bottom: 12rpx;
}
.category-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1px solid #f0f0f0;
}
.category-item:last-child {
  border-bottom: none;
}
